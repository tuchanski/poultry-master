  "pio_output": "data/prepared/pio",
  "health_output": "data/prepared/health-binary-reviewed",
  "detector_checkpoint": "yolo11n.pt",
  "classifier_checkpoint": "yolo11n-cls.pt",
  "inference": {
    "detector": "models/detector.pt",
    "classifier": "models/classifier.pt",
    "device": "cpu",
    "detector_imgsz": 640,
    "classifier_imgsz": 224,
    "confidence": 0.25,
    "iou": 0.5,
