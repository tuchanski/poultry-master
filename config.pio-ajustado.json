{
  "seed": 42,
  "split_ratios": {
    "train": 0.7,
    "val": 0.15,
    "test": 0.15
  },
  "pio_source": "pio/data",
  "health_source": "kaggle/extracted/Multimodal Chicken Datasets",
  "health_review": "data/review/binary-manual/health.csv",
